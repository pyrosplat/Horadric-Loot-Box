{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horadric Loot Box",
  "version": "0.8.11",
  "identifier": "com.horadriclootbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Horadric Loot Box",
        "width": 1520,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0b0a09",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: hlbart: http://hlbart.localhost https://hlbart.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Diablo II: Resurrected muling tool",
    "longDescription": "Move items between offline Diablo II: Resurrected characters, shared stashes and unlimited vaults. Supports Reign of the Warlock (save v105).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

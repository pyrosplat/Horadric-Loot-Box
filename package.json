{
  "name": "horadric-loot-box",
  "version": "2.5.0",
  "description": "Muling tool for Diablo II: Resurrected — Reign of the Warlock (save v105)",
  "scripts": {
    "gamedata": "node scripts/build-gamedata.mjs",
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "node scripts/build-gamedata.mjs && node scripts/copy-ocr.mjs && tsc -p . && vite build",
    "preview": "vite preview",
    "dev:web": "node scripts/copy-ocr.mjs && vite --mode web",
    "build:web": "node scripts/build-gamedata.mjs && node scripts/copy-ocr.mjs && tsc -p . && vite build --mode web",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "ocr": "node scripts/copy-ocr.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
